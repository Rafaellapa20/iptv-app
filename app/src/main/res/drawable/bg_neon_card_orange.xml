<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_wash"/>
            <corners android:radius="@dimen/radius_card"/>
            <stroke android:width="@dimen/focus_stroke" android:color="@color/accent"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_elevated"/>
            <corners android:radius="@dimen/radius_card"/>
            <stroke android:width="1dp" android:color="@color/surface_line"/>
        </shape>
    </item>
</selector>
