<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#80C8B8" android:centerColor="#95DED1" android:endColor="#AAEBDC" android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#4F726C" android:centerColor="#5C857E" android:endColor="#6B9990" android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
