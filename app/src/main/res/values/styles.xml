<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:windowAnimationStyle">@style/AppWindowTransition</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="colorPrimary">@color/bg_elevated</item>
        <item name="colorPrimaryDark">@color/bg_primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Transição suave (fade) aplicada automaticamente a todos os ecrãs,
         sem precisar de mexer em cada Activity individualmente. -->
    <style name="AppWindowTransition" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>
</resources>
