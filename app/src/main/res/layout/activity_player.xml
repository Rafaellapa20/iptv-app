<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Secondary Player (For Seamless Zapping & Multi-Screen) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view_secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="invisible"
        app:resize_mode="fill"
        app:surface_type="texture_view"
        app:use_controller="false"/>

    <!-- Foreground Primary Player -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fill"
        app:surface_type="texture_view"
        app:use_controller="true"/>

    <!-- Fast Buffering Overlay (Substitui ecrã preto por Capa/Logo + Spinner) -->
    <RelativeLayout
        android:id="@+id/rlBufferingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D071E"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivLoadingCover"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_centerHorizontal="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <ProgressBar
            android:id="@+id/pbLoadingSpinner"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_below="@id/ivLoadingCover"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:indeterminateTint="#00E5FF" />

        <TextView
            android:id="@+id/tvLoadingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pbLoadingSpinner"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:text="A carregar canal..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Floating Control Buttons (Star, REC & Split Screen) -->
    <LinearLayout
        android:id="@+id/llFloatingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="140dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnFavPlayer"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/selector_button_login"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="#FFCC00"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Favorito" />

        <ImageButton
            android:id="@+id/btnRec"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/selector_button_login"
            android:src="@android:drawable/presence_video_online"
            app:tint="#FF0000"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Gravar Canal" />

        <ImageButton
            android:id="@+id/btnSplitScreen"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/selector_button_login"
            android:src="@android:drawable/ic_menu_today"
            app:tint="#00E5FF"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Multi Tela" />
    </LinearLayout>

    <!-- Overlay EPG Info Bar (Bottom) -->
    <LinearLayout
        android:id="@+id/epgContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0B071E"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvEpgProgram"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="Sem Informação de EPG" />

            <!-- Network Status Indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12dp">

                <ImageView
                    android:id="@+id/ivNetworkStatus"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/presence_online"
                    app:tint="#00FF00" />

                <TextView
                    android:id="@+id/tvNetworkSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#00FF00"
                    android:textSize="12sp"
                    android:text="Estável" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbEpgProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progressTint="#00E5FF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEpgTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#00E5FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Overlay de Próximo Episódio (Séries/VOD) -->
    <RelativeLayout
        android:id="@+id/llNextEpisode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_item_focus"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNextCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo episódio em 10s..."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNextEpisode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvNextCountdown"
            android:layout_marginTop="8dp"
            android:backgroundTint="#00E5FF"
            android:text="▶ REPRODUZIR AGORA"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

</FrameLayout>
