<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Secondary Player (For Seamless Zapping & Multi-Screen) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view_secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="invisible"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false"/>

    <!-- Foreground Primary Player -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="true"/>

    <!-- Fast Buffering Overlay (Substitui ecrã preto por Capa/Logo + Spinner) -->
    <RelativeLayout
        android:id="@+id/rlBufferingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivLoadingCover"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_centerHorizontal="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <ProgressBar
            android:id="@+id/pbLoadingSpinner"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_below="@id/ivLoadingCover"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/tvLoadingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pbLoadingSpinner"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:text="A carregar canal..."
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_item"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvDiagnostics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvLoadingTitle"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="@dimen/text_label"
            android:visibility="gone"
            android:textStyle="italic" />
    </RelativeLayout>

    <!-- Floating Control Buttons (Star, REC & Split Screen) -->
    <LinearLayout
        android:id="@+id/llFloatingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="140dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/media_route_button_player"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="12dp"
            android:mediaRouteTypes="user"
            android:focusable="true"
            android:contentDescription="Cast" />

        <ImageButton
            android:id="@+id/btnFavPlayer"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/selector_button_login"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="@color/status_warn"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Favorito" />

        <ImageButton
            android:id="@+id/btnRec"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/selector_button_login"
            android:src="@android:drawable/presence_video_online"
            app:tint="@color/status_live"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Gravar Canal" />

        <ImageButton
            android:id="@+id/btnSplitScreen"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/selector_button_login"
            android:src="@android:drawable/ic_menu_today"
            app:tint="@color/accent"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Multi Tela" />
    </LinearLayout>

    <!-- Overlay EPG Info Bar (Bottom) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/epgContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/overlay_player"
        android:visibility="gone">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvEpgProgram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"
                    android:text="Sem Informação de EPG" />

                <!-- Network Status Indicator -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:id="@+id/ivNetworkStatus"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@android:drawable/presence_online"
                        app:tint="@color/accent" />

                    <TextView
                        android:id="@+id/tvNetworkSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold"
                        android:text="--- Mbps" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvEpgTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_meta"
                android:text="--:-- - --:--" />

            <ProgressBar
                android:id="@+id/pbEpgProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:progressDrawable="@drawable/bg_progress"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Overlay de Próximo Episódio (Séries/VOD) -->
    <RelativeLayout
        android:id="@+id/llNextEpisode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_item_focus"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNextCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo episódio em 10s..."
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_meta" />

        <Button
            android:id="@+id/btnNextEpisode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvNextCountdown"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/accent"
            android:text="▶ REPRODUZIR AGORA"
            android:textColor="@color/cta_on"
            android:textSize="@dimen/text_label"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Zapping Numérico Overlay -->
    <TextView
        android:id="@+id/tvChannelNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="48dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_hero"
        android:textStyle="bold"
        android:shadowColor="@color/bg_primary"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:visibility="gone" />


    <!-- Mini Guia Zapping Transparente -->
    <LinearLayout
        android:id="@+id/llMiniGuia"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/overlay_mini_guide"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANAIS"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMiniGuia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />
    </LinearLayout>

</FrameLayout>
