<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_item_focus"
    android:focusable="true"
    android:clickable="true"
    android:longClickable="true">

    <TextView
        android:id="@+id/tvChannelNum"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:gravity="center"
        android:text="1" />

    <ImageView
        android:id="@+id/ivChannelIcon"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvChannelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Botão de Estrela Favoritos: alvo de toque maior (48dp) para ser mais fácil de acertar,
         com um único toque/clique a alternar o favorito (sem precisar de long-press). -->
    <ImageView
        android:id="@+id/ivFavIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="8dp"
        android:src="@android:drawable/btn_star_big_on"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Marcar/desmarcar como favorito"
        android:layout_marginStart="4dp" />
</LinearLayout>
