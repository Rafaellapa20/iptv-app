<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D071E">

    <!-- Top Navigation -->
    <LinearLayout
        android:id="@+id/topNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/nav_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/selector_nav_item"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginEnd="24dp"/>

        <TextView
            android:id="@+id/nav_canais"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canais"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/selector_nav_item"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginEnd="24dp"/>

        <TextView
            android:id="@+id/nav_filmes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filmes"
            android:textColor="#FFCC00"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/selector_nav_item"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginEnd="24dp"/>

        <TextView
            android:id="@+id/nav_series"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Séries"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/selector_nav_item"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginEnd="24dp"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/selector_nav_item"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#FFFFFF"
            android:focusable="true"
            android:clickable="true"/>
    </LinearLayout>

    <!-- Título Principal (Sidebar) -->
    <TextView
        android:id="@+id/tvMainTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="FILMES"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/topNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider" />

    <!-- Sidebar RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSidebar"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvMainTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Divisor vertical opcional -->
    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#333333"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/topNav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/rvSidebar" />

    <!-- Filtro de ordenação simulado (opcional, igual à imagem) -->
    <TextView
        android:id="@+id/tvSortBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ordenar por Adicionad. ˅"
        android:textColor="#FFFFFF"
        android:background="#00A2E8"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/topNav"
        app:layout_constraintStart_toEndOf="@id/divider" />

    <!-- Grelha de Filmes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMovieGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="50dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvSortBtn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:indeterminateTint="#00FFFF"
        app:layout_constraintTop_toBottomOf="@id/topNav"
        app:layout_constraintStart_toStartOf="@id/rvMovieGrid"
        app:layout_constraintEnd_toEndOf="@id/rvMovieGrid"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
