<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050A14"
    tools:context=".MainActivity">

    <!-- Fundo Desfocado Ambiente -->
    <ImageView
        android:id="@+id/ivMainBackgroundBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.2"
        android:src="@drawable/logo"
        android:visibility="gone"/>

    <!-- BARRA SUPERIOR (HEADER BAR) -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingHorizontal="24dp">

        <LinearLayout
            android:id="@+id/llHeaderLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ IPTV "
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GLOBAL"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvUserLogged"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil: Rafael"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_vpn_badge" />

            <ImageButton
                android:id="@+id/btnSwitchUser"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#00E5FF"
                android:contentDescription="Mudar Utilizador"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#FFFFFF"
                android:contentDescription="Pesquisar"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="#FFFFFF"
                android:contentDescription="Atualizar"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="15:42"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlaylistStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="🟢 1 playlist ativa"
                android:textColor="#00FF88"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- HERO ZONE (LIVE TV, MOVIES, SERIES) -->
    <LinearLayout
        android:id="@+id/gridHeroCards"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:weightSum="3">

        <!-- CARD 1: LIVE TV (MINI-PLAYER COM CANAL A DAR EM DIRETO) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#0A1929"
            app:cardElevation="6dp"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:nextFocusDown="@+id/btnQuickFavorites"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/selector_item_scale">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Mini-Player: mostra canal a dar em direto -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/miniPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="false"
                    app:surface_type="texture_view"
                    app:resize_mode="zoom" />

                <!-- Overlay escuro semi-transparente no fundo para texto legível -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/bg_gradient_card_overlay" />

                <!-- Badge LIVE no topo -->
                <TextView
                    android:id="@+id/tvLiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true"
                    android:layout_margin="6dp"
                    android:text="🔴 LIVE"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_live_badge" />

                <!-- Nome do Canal -->
                <TextView
                    android:id="@+id/tvTitleTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/tvSubTv"
                    android:layout_marginHorizontal="8dp"
                    android:text="LIVE TV"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <!-- Programa EPG a Dar -->
                <TextView
                    android:id="@+id/tvSubTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="6dp"
                    android:text="🔴 A DAR: Telejornal"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 2: MOVIES (VOD) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFilmes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#00000000"
            app:cardElevation="6dp"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:nextFocusDown="@+id/btnQuickEpg"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/selector_item_scale">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_neon_card_cyan"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/ivCardFilmesBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/tvTitleFilmes"
                    android:layout_marginBottom="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo" />

                <TextView
                    android:id="@+id/tvTitleFilmes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/tvSubFilmes"
                    android:text="MOVIES (VOD)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSubFilmes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="Catálogo de Filmes ▸"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 3: SERIES -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSeries"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#00000000"
            app:cardElevation="6dp"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:nextFocusDown="@+id/btnQuickMultiScreen"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/selector_item_scale">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_neon_card_cyan"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/ivCardSeriesBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/tvTitleSeries"
                    android:layout_marginBottom="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo" />

                <TextView
                    android:id="@+id/tvTitleSeries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/tvSubSeries"
                    android:text="SERIES"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSubSeries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="Temporadas &amp; Episódios ▸"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- QUICK ACCESS BAR -->
    <LinearLayout
        android:id="@+id/llQuickAccessBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="6dp"
        android:weightSum="5"
        android:descendantFocusability="afterDescendants"
        android:focusable="false">

        <Button
            android:id="@+id/btnQuickFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_smarters_sage"
            android:text="⭐ Favoritos"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/cardTv"
            android:nextFocusDown="@id/rvContinueWatching"
            android:nextFocusRight="@id/btnQuickEpg" />

        <Button
            android:id="@+id/btnQuickEpg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_smarters_sage"
            android:text="📺 Guia EPG"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/cardFilmes"
            android:nextFocusDown="@id/rvContinueWatching"
            android:nextFocusLeft="@id/btnQuickFavorites"
            android:nextFocusRight="@id/btnQuickSettings" />

        <Button
            android:id="@+id/btnQuickSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_smarters_sage"
            android:text="⚡ SpeedTest"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/cardFilmes"
            android:nextFocusDown="@id/rvContinueWatching"
            android:nextFocusLeft="@id/btnQuickEpg"
            android:nextFocusRight="@id/btnQuickMultiScreen" />

        <Button
            android:id="@+id/btnQuickMultiScreen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_smarters_sage"
            android:text="🔲 Multi-Ecrã"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/cardSeries"
            android:nextFocusDown="@id/rvContinueWatching"
            android:nextFocusLeft="@id/btnQuickSettings"
            android:nextFocusRight="@id/btnQuickCatchup" />

        <Button
            android:id="@+id/btnQuickCatchup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_smarters_sage"
            android:text="⚙ Definições"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/cardSeries"
            android:nextFocusDown="@id/rvContinueWatching"
            android:nextFocusLeft="@id/btnQuickMultiScreen" />
    </LinearLayout>

    <!-- FILMES EM DESTAQUE REMOVIDOS -->
    <!-- CONTINUAR A VER -->
    <TextView
        android:id="@+id/tvContinueTitleHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTINUAR A VER"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="2dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContinueWatching"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp" />

    <!-- FILMES EM DESTAQUE -->
    <TextView
        android:id="@+id/tvFeaturedTitleHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎬 FILMES EM DESTAQUE"
        android:textColor="#00E5FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="2dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFeaturedMovies"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- BARRA DE RODAPÉ -->
    <RelativeLayout
        android:id="@+id/footerBar"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/tvVencimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Validade : Ilimitado"
            android:textColor="#8A99AD"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 SOCKS5 VPS PROTECTED"
                android:textColor="#00FF88"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:background="@drawable/bg_vpn_badge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="v9.1"
                android:textColor="#8A99AD"
                android:textSize="9sp" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
