<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A14"
    tools:context=".MainActivity">

    <!-- Fundo Desfocado Ambiente -->
    <ImageView
        android:id="@+id/ivMainBackgroundBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.2"
        android:src="@drawable/logo"/>

    <!-- Mascara de Gradiente Escuro -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0050A14"/>

    <!-- BARRA SUPERIOR (HEADER BAR) -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logotipo & Titulo IPTV GLOBAL -->
        <LinearLayout
            android:id="@+id/llHeaderLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ IPTV "
                android:textColor="#00E5FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GLOBAL"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Direita: Perfil, Pesquisa, Refresh, Hora, Playlist Ativa -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Perfil Utilizador -->
            <TextView
                android:id="@+id/tvUserLogged"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil: Rafael"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_vpn_badge" />

            <!-- Botao Switch User -->
            <ImageButton
                android:id="@+id/btnSwitchUser"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#00E5FF"
                android:contentDescription="Mudar Utilizador" />

            <!-- Pesquisa Global -->
            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#FFFFFF"
                android:contentDescription="Pesquisar" />

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="#FFFFFF"
                android:contentDescription="Atualizar" />

            <!-- Relogio Digital -->
            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="15:42"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Playlist Ativa Status -->
            <TextView
                android:id="@+id/tvPlaylistStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="🟢 1 playlist ativa"
                android:textColor="#00FF88"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- HERO ZONE (3 CARTÕES NEON EM DESTAQUE: LIVE TV, MOVIES, SERIES) -->
    <TextView
        android:id="@+id/tvHeroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hero Zone"
        android:textColor="#8A99AD"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/gridHeroCards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/tvHeroTitle"
        app:layout_constraintBottom_toTopOf="@id/tvQuickAccessTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CARD 1: LIVE TV (BORDER NEON CYAN) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="#00000000"
            app:cardElevation="8dp"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/selector_item_scale">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_neon_card_cyan"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvLiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 LIVE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_live_badge" />

                <!-- Poster / Screenshots de Transmissão -->
                <ImageView
                    android:id="@+id/ivCardTvBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/tvLiveBadge"
                    android:layout_above="@id/tvTitleTv"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo" />

                <TextView
                    android:id="@+id/tvTitleTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/tvSubTv"
                    android:text="LIVE TV"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSubTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="335 Canais em Direto"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 2: MOVIES (VOD) (BORDER NEON CYAN) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFilmes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="#00000000"
            app:cardElevation="8dp"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/selector_item_scale">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_neon_card_cyan"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivCardFilmesBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/tvTitleFilmes"
                    android:layout_marginBottom="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo" />

                <TextView
                    android:id="@+id/tvTitleFilmes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/tvSubFilmes"
                    android:text="MOVIES (VOD)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSubFilmes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="Catálogo de Filmes ▸"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 3: SERIES (BORDER NEON CYAN) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSeries"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="#00000000"
            app:cardElevation="8dp"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/selector_item_scale">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_neon_card_cyan"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivCardSeriesBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/tvTitleSeries"
                    android:layout_marginBottom="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo" />

                <TextView
                    android:id="@+id/tvTitleSeries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/tvSubSeries"
                    android:text="SERIES"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSubSeries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="Temporadas &amp; Episódios ▸"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- QUICK ACCESS BAR (BARRA DE ACESSO RÁPIDO IGUAL À IMAGEM DE REFERÊNCIA) -->
    <TextView
        android:id="@+id/tvQuickAccessTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Access Bar"
        android:textColor="#8A99AD"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/llQuickAccessBar"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/llQuickAccessBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:weightSum="5"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/llBottomRows"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Quick 1: Favoritos -->
        <Button
            android:id="@+id/btnQuickFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_smarters_sage"
            android:text="⭐ Favoritos"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />

        <!-- Quick 2: Guia EPG Completo -->
        <Button
            android:id="@+id/btnQuickEpg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_smarters_sage"
            android:text="📺 Guia EPG"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />

        <!-- Quick 3: Definições -->
        <Button
            android:id="@+id/btnQuickSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_smarters_sage"
            android:text="⚙ Definições"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />

        <!-- Quick 4: Multi-Ecrã -->
        <Button
            android:id="@+id/btnQuickMultiScreen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_smarters_sage"
            android:text="🔲 Multi-Ecrã"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />

        <!-- Quick 5: Catch-up 7d -->
        <Button
            android:id="@+id/btnQuickCatchup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_smarters_sage"
            android:text="⏱ Catch-up 7d"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- LINHA INFERIOR "FILMES EM DESTAQUE" E "CONTINUAR A VER" -->
    <LinearLayout
        android:id="@+id/llBottomRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/footerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvFeaturedTitleHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 FILMES EM DESTAQUE &amp; LANÇAMENTOS"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="2dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeaturedMovies"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvContinueTitleHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTINUAR A VER"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="2dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContinueWatching"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- BARRA DE RODAPÉ (VPN BADGE & VALIDADE) -->
    <RelativeLayout
        android:id="@+id/footerBar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvVencimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Validade : Ilimitado"
            android:textColor="#8A99AD"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 SOCKS5 VPS PROTECTED"
                android:textColor="#00FF88"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:background="@drawable/bg_vpn_badge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="v8.9"
                android:textColor="#8A99AD"
                android:textSize="9sp" />
        </LinearLayout>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
