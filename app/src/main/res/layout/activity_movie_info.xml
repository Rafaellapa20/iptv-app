<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".MovieInfoActivity">

    <!-- Fundo Desfocado Ambiente -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.25"
        android:src="@drawable/logo"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="28dp">

            <!-- Capa / Poster Principal (Esquerda) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvPoster"
                android:layout_width="210dp"
                android:layout_height="310dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo" />
            </androidx.cardview.widget.CardView>

            <!-- Título do Filme / Série -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_display"
                android:textStyle="bold"
                android:text="OPPENHEIMER"
                app:layout_constraintStart_toEndOf="@id/cvPoster"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Linha Metadata Pills: 2024 · 12+ · 4K · IMDb 8.2 · Sci-Fi/Action -->
            <LinearLayout
                android:id="@+id/llMetadata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="@id/tvTitle"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@color/accent_wash" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="12+"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@color/accent_wash" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="4K"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@color/accent_wash" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="IMDb 8.2 ★"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:background="@color/accent_wash" />

                <TextView
                    android:id="@+id/tvGenre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Sci-Fi/Action"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_meta" />
            </LinearLayout>

            <!-- Sinopse / Overview -->
            <TextView
                android:id="@+id/tvPlot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_meta"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:focusable="true"
                android:clickable="true"
                android:text="Synopsis, the Trinity test chosen to mes with a Trinity test vplosnc monter of Oppenheimer..."
                app:layout_constraintStart_toStartOf="@id/tvTitle"
                app:layout_constraintTop_toBottomOf="@id/llMetadata"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- "Ver mais / Ver menos" para expandir sinopse -->
            <TextView
                android:id="@+id/tvPlotToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="▼ Ver mais"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/tvTitle"
                app:layout_constraintTop_toBottomOf="@id/tvPlot"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Seção de Atores (CAST) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCast"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="@id/tvTitle"
                app:layout_constraintTop_toBottomOf="@id/tvPlotToggle"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Botões de Ação -->
            <LinearLayout
                android:id="@+id/llMainActionButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="@id/tvTitle"
                app:layout_constraintTop_toBottomOf="@id/rvCast"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:id="@+id/btnPlay"
                    android:layout_width="160dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_button_neon"
                    android:text="Reproduzir"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_meta"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <!-- Botão Adicionar aos Favoritos (Barra Completa) -->
            <Button
                android:id="@+id/btnFavorite"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_smarters_sage"
                android:text="Adicionar aos Favoritos"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true"
                app:layout_constraintStart_toStartOf="@id/tvTitle"
                app:layout_constraintTop_toBottomOf="@id/llMainActionButtons"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Botão Failover Backup (Barra Completa) -->
            <Button
                android:id="@+id/btnBackup"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_smarters_sage"
                android:text="Failover (Backup Servidor 2)"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true"
                app:layout_constraintStart_toStartOf="@id/tvTitle"
                app:layout_constraintTop_toBottomOf="@id/btnFavorite"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
