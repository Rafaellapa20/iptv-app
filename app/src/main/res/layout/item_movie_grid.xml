<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_margin="8dp"
    android:focusable="true"
    android:clickable="true"
    android:stateListAnimator="@animator/selector_item_scale"
    android:background="@drawable/selector_movie_card">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="170dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#222"
        android:duplicateParentState="true"
        app:cardElevation="4dp">

        <ImageView
            android:id="@+id/ivMoviePoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:duplicateParentState="true"
            android:background="@drawable/bg_movie_grid_text">
            
            <TextView
                android:id="@+id/tvMovieTitleFallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="center"/>

            <ProgressBar
                android:id="@+id/pbMovieProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progressDrawable="@drawable/bg_progress_red"
                android:visibility="gone"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>
