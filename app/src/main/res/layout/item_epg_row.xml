<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <!-- Card do Canal (Lado Esquerdo) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardChannelHeader"
        android:layout_width="160dp"
        android:layout_height="64dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardElevation="4dp"
        android:focusable="true"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackground"
        android:stateListAnimator="@animator/selector_item_scale">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivChannelLogo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Sport TV 1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="2" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Lista Horizontal de Programas EPG -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProgramsHorizontal"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="8dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
